import datetime
from typing import Iterable, Literal, Optional

class CalendarError(ValueError): ...

class Holiday:
    @property
    def name(self) -> str: ...
    @property
    def actual(self) -> datetime.date: ...
    @property
    def observed(self) -> datetime.date: ...

class Calendar:
    def __init__(self, code: str) -> None: ...
    @staticmethod
    def fixed(
        code: str,
        valid_from: datetime.date,
        valid_until: datetime.date,
        weekend: Iterable[str] = ("Sat", "Sun"),
        days_off: Iterable[datetime.date] = (),
    ) -> "Calendar": ...
    def with_days_off(self, dates: Iterable[datetime.date]) -> "Calendar": ...
    @property
    def code(self) -> str: ...
    @property
    def name(self) -> str: ...
    @property
    def zone(self) -> Optional[str]: ...
    @property
    def valid_from(self) -> datetime.date: ...
    @property
    def valid_until(self) -> datetime.date: ...
    @property
    def confirmed_until(self) -> datetime.date: ...
    def is_business_day(self, day: datetime.date) -> bool: ...
    def is_holiday(self, day: datetime.date) -> bool: ...
    def status(self, day: datetime.date) -> Literal["confirmed", "projected"]: ...
    def holidays(self, year: int) -> list[Holiday]: ...
    def holidays_between(self, start: datetime.date, end: datetime.date) -> list[Holiday]: ...

def calendar_codes() -> list[str]: ...
