import datetime
from typing import Any, Iterator, Literal, Mapping, Optional, Union

from .calendar import Calendar

class ScheduleError(ValueError): ...

class Occurrence:
    @property
    def actual(self) -> datetime.datetime: ...
    @property
    def observed(self) -> datetime.datetime: ...
    @property
    def adjustment(self) -> Literal["exact", "later", "earlier"]: ...

class Occurrences(Iterator[Occurrence]):
    def __iter__(self) -> "Occurrences": ...
    def __next__(self) -> Occurrence: ...

class Schedule:
    def __init__(self, spec: str) -> None: ...
    @property
    def spec(self) -> str: ...
    @property
    def kind(self) -> Literal["date", "time", "datetime"]: ...
    def describe(self) -> str: ...
    def occurrences(
        self,
        after: Optional[datetime.datetime] = None,
        calendar: Union[Calendar, str, None] = None,
        tz: Optional[str] = None,
    ) -> Occurrences: ...
    def take(
        self,
        n: int,
        after: Optional[datetime.datetime] = None,
        calendar: Union[Calendar, str, None] = None,
        tz: Optional[str] = None,
    ) -> list[Occurrence]: ...

class Source:
    @property
    def rule_id(self) -> Optional[str]: ...
    @property
    def actual(self) -> datetime.datetime: ...
    @property
    def basis(self) -> Optional[datetime.datetime]: ...

class Slot:
    @property
    def at(self) -> datetime.datetime: ...
    @property
    def sources(self) -> list[Source]: ...

class Slots(Iterator[Slot]):
    def __iter__(self) -> "Slots": ...
    def __next__(self) -> Slot: ...

class Document:
    def __init__(self, doc: Union[Mapping[str, Any], str]) -> None: ...
    def slots(self, after: Optional[datetime.datetime] = None) -> Slots: ...
    def take(self, n: int, after: Optional[datetime.datetime] = None) -> list[Slot]: ...
    def to_json(self) -> str: ...

def describe(spec: str) -> str: ...
