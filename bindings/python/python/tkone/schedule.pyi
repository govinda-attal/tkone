import datetime
from typing import Any, Iterator, Literal, Mapping, Optional, Sequence, Union

from .calendar import Calendar

class ScheduleError(ValueError): ...

class Occurrence:
    @property
    def actual(self) -> datetime.datetime: ...
    @property
    def observed(self) -> datetime.datetime: ...
    @property
    def adjustment(self) -> Literal["exact", "later", "earlier"]: ...

class Occurrences(Iterator[Occurrence]):
    def __iter__(self) -> "Occurrences": ...
    def __next__(self) -> Occurrence: ...

class Schedule:
    def __init__(self, spec: str) -> None: ...
    @property
    def spec(self) -> str: ...
    @property
    def kind(self) -> Literal["date", "time", "datetime"]: ...
    def describe(self) -> str: ...
    def occurrences(
        self,
        after: Optional[datetime.datetime] = None,
        calendar: Union[Calendar, str, None] = None,
        tz: Optional[str] = None,
    ) -> Occurrences: ...
    def take(
        self,
        n: int,
        after: Optional[datetime.datetime] = None,
        calendar: Union[Calendar, str, None] = None,
        tz: Optional[str] = None,
    ) -> list[Occurrence]: ...

class Source:
    @property
    def rule_id(self) -> Optional[str]: ...
    @property
    def actual(self) -> datetime.datetime: ...
    @property
    def basis(self) -> Optional[datetime.datetime]: ...

class Slot:
    @property
    def at(self) -> datetime.datetime: ...
    @property
    def sources(self) -> list[Source]: ...

class Slots(Iterator[Slot]):
    def __iter__(self) -> "Slots": ...
    def __next__(self) -> Slot: ...

class Boundary:
    @property
    def at(self) -> datetime.datetime: ...
    @property
    def actual(self) -> datetime.datetime: ...

class Period:
    @property
    def start(self) -> Boundary: ...
    @property
    def end(self) -> Boundary: ...
    @property
    def slot(self) -> Slot: ...

class Periods(Iterator[Period]):
    def __iter__(self) -> "Periods": ...
    def __next__(self) -> Period: ...

class Document:
    def __init__(self, doc: Union[Mapping[str, Any], str], calendars: Sequence[Calendar] = ()) -> None: ...
    @property
    def start(self) -> datetime.datetime: ...
    @property
    def until(self) -> Optional[datetime.datetime]: ...
    def slots(self, after: Optional[datetime.datetime] = None) -> Slots: ...
    def take(self, n: int, after: Optional[datetime.datetime] = None) -> list[Slot]: ...
    def between(self, start: datetime.datetime, end: datetime.datetime) -> Slots: ...
    def periods(
        self, start: Optional[datetime.datetime] = None, end: Optional[datetime.datetime] = None
    ) -> Periods: ...
    def moved_before_start(self) -> list[Slot]: ...
    def to_json(self) -> str: ...

class Entry:
    @property
    def key(self) -> str: ...
    @property
    def slot(self) -> Slot: ...
    @property
    def since(self) -> Boundary: ...

class Moment:
    @property
    def at(self) -> datetime.datetime: ...
    @property
    def entries(self) -> list[Entry]: ...

class Moments(Iterator[Moment]):
    def __iter__(self) -> "Moments": ...
    def __next__(self) -> Moment: ...

class Timeline:
    def __init__(self, lanes: Sequence[tuple[str, Document]]) -> None: ...
    @property
    def keys(self) -> list[str]: ...
    def between(self, start: datetime.datetime, end: datetime.datetime) -> Moments: ...

def describe(spec: str) -> str: ...
